# OpenTofu (VM state and DNS state)
tofu/.terraform/
tofu/.terraform.lock.hcl
tofu/dns/.terraform/
tofu/dns/.terraform.lock.hcl
tofu/clusters/.terraform/
tofu/clusters/.terraform.lock.hcl
*.tfstate
*.tfstate.*
crash.log

# Packer
packer/manifest-*.json
packer/packer_cache/

# Ansible generated inventory (written by tofu)
ansible/inventory/*.ini

# Lab cluster data, written by tofu/clusters. clusters.yml holds one private
# key per participant; clusters.txt is the trainer's address table.
ansible/data/clusters.yml
tofu/clusters/clusters.txt

# Vault password files
*.vault-pass
